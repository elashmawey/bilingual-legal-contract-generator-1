# ==============================================================
# BILINGUAL LEGAL CONTRACT GENERATOR - ENVIRONMENT VARIABLES
# ==============================================================

# Required: Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Preferred Gemini Model (defaults to gemini-2.5-flash with fallback to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ==============================================================
# PAYPAL REAL PAYMENT GATEWAY CONFIGURATION
# ==============================================================
# Get your PayPal credentials from: https://developer.paypal.com/dashboard/applications
# Frontend Public Client ID (used to display PayPal Smart Buttons)
VITE_PAYPAL_CLIENT_ID=

# Backend Secret (used by Vercel Serverless Function to verify & capture real payments)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal Environment: 'live' for real payments, 'sandbox' for test testing
PAYPAL_MODE=live

# Server-only owner access code. Generate a new random value and set it in Vercel.
OWNER_ACCESS_CODE=
